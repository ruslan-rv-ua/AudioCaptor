# Normalize line endings: store as LF, checkout as LF (not CRLF on Windows)
* text=auto eol=lf

# Rust
*.rs    text eol=lf
*.toml  text eol=lf

# Web / Svelte
*.ts    text eol=lf
*.js    text eol=lf
*.svelte text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Config
*.yaml  text eol=lf
*.yml   text eol=lf
justfile text eol=lf

# Binary files — no conversion
*.png   binary
*.ico   binary
*.icns  binary
*.wasm  binary
